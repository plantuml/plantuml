# plantuml_embed_file(<input> <output> <symbol>)
#
# Writes the C file <output>, which defines the bytes of <input>:
#   const unsigned char <symbol>[];
#   const unsigned int <symbol>_size;
# Runs when CMake configures, and again whenever <input> changes.
# Portable replacement for xxd -i or C23 #embed (MSVC supports neither).
function(plantuml_embed_file input output symbol)
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${input})
	file(READ ${input} hex HEX)
	string(LENGTH "${hex}" hex_length)
	math(EXPR size "${hex_length} / 2")
	# 0x.., for every byte, and a line break every 32 bytes
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	# (CMake regular expressions have neither {n} nor more than 9 groups)
	string(REPEAT "0x..," 32 line)
	string(REGEX REPLACE "(${line})" "\\1\n" bytes "${bytes}")
	file(WRITE ${output}
		"/* Generated by embed_font.cmake from ${symbol}, do not edit */\n"
		"const unsigned char ${symbol}[${size}] = {\n${bytes}\n};\n"
		"const unsigned int ${symbol}_size = ${size};\n")
endfunction()
