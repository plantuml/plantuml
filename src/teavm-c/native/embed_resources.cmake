# plantuml_embed_resources(<output> <name>=<file> ...)
#
# Writes the C file <output>, which embeds the bytes of every <file> in the
# executable and registers them, under the logical <name> that Java asks for
# (for instance "themes/puml-theme-amiga.puml"), in the table that
# plantuml_resources.c searches:
#   const plantuml_resource plantuml_resources[];
#   const int32_t plantuml_resources_count;
# Runs when CMake configures, and again whenever a <file> changes.
# Portable replacement for xxd -i or C23 #embed (MSVC supports neither).
function(plantuml_embed_resources output)
	set(arrays "")
	set(entries "")
	set(index 0)
	foreach(pair IN LISTS ARGN)
		string(FIND "${pair}" "=" equals)
		string(SUBSTRING "${pair}" 0 ${equals} name)
		math(EXPR path_start "${equals} + 1")
		string(SUBSTRING "${pair}" ${path_start} -1 path)
		set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${path})
		file(READ ${path} hex HEX)
		string(LENGTH "${hex}" hex_length)
		math(EXPR size "${hex_length} / 2")
		# 0x.., for every byte, and a line break every 32 bytes
		string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
		string(REPEAT "0x..," 32 line)
		string(REGEX REPLACE "(${line})" "\\1\n" bytes "${bytes}")
		# A zero-length array is not valid C: keep one byte, size says 0
		string(APPEND arrays "static const unsigned char plantuml_resource_${index}[${size} + 1] = {\n${bytes}\n0};\n")
		string(APPEND entries "\t{\"${name}\", plantuml_resource_${index}, ${size}},\n")
		math(EXPR index "${index} + 1")
	endforeach()
	file(WRITE ${output}
		"/* Generated by embed_resources.cmake, do not edit */\n"
		"#include \"plantuml_resources.h\"\n\n"
		"${arrays}\n"
		"const plantuml_resource plantuml_resources[] = {\n${entries}\t{0, 0, 0}\n};\n"
		"const int32_t plantuml_resources_count = ${index};\n")
endfunction()
