a(div) (False, 'ZeroDivisionError')
a(raise,"msg") (False, 'ValueError')
a(nil()) (False, 'TypeError')
a(t())   (False, 'TypeError')
a(s())   (False, 'TypeError')
a(true()) (False, 'TypeError')
a(nil+1) (False, 'TypeError')
a(a+1)   (False, 'TypeError')
a(s+1)   (False, 'TypeError')
a(true+1) (True, 2)
a(nil.x) (False, 'TypeError')
a(a.x)   (False, 'KeyError')
a(s.x)   (False, 'TypeError')
a(true.x) (False, 'TypeError')
a(nil.x=5) (False, 'TypeError')
a(a.x=5)   (False, 'TypeError')
a(s.x=5)   (False, 'TypeError')
a(true.x=5) (False, 'TypeError')
a(#nil)  (False, 'TypeError')
a(#t)    (True, 0)
a(#s)    (True, 11)
a(#A)    (True, 1)
a(#true) (False, 'TypeError')
a(nil>1) (False, 'TypeError')
a(A>1)   (False, 'TypeError')
a(s>1)   (False, 'TypeError')
a(true>1) (True, False)
a(-nil) (False, 'TypeError')
a(-A)   (False, 'TypeError')
a(-s)   (False, 'TypeError')
a(-str) (False, 'TypeError')
-------- string concatenation
"a"+"b" (True, 'ab')
"a"+None (False, 'TypeError')
