-------- iteration tests
a(iter(None)) (False, 'TypeError')
a(iter(A))   (True, ['x'])
a(iter(s))   (True, ['s', 'o', 'm', 'e', ' ', 's', 't', 'r', 'i', 'n', 'g'])
a(iter(true)) (False, 'TypeError')
-------- builtin argument tests
a(int(nil)) (False, 'TypeError')
a(int(t))   (False, 'TypeError')
a(int(s))   (False, 'ValueError')
a(int('1')) (True, 1)
raise KeyError("msg") (False, 'KeyError')
