---
output: preproc, svg
---
@startuml
' EXPECT (preproc):
' participant "Auth service" as Auth
!class Service:
!    def __init__(self, name):
!        self.name = name
!    def label(self):
!        return self.name + " service"

!auth = Service("Auth")
participant "!{auth.label()}" as !{auth.name}
@enduml
