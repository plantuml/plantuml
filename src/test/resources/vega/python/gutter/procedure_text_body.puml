@startuml
' EXPECT (preproc):
' participant Auth #FFCCCC
' note right of Auth : Auth is up
' participant Billing #CCE5FF
' note right of Billing : Billing is up
!def service(name, color):
    participant ${name} ${color}
    note right of ${name} : ${name} is up

!service("Auth", "#FFCCCC")
!service("Billing", "#CCE5FF")
@enduml
