---
output: svg
---
@startuml
' https://github.com/plantuml/plantuml/pull/2989
' Same diagram as nonreg.svg.EntryExitPointStemTest (edges_meet_entry_and_exit_points_centred_and_perpendicular).
' Vega forces Smetana, which has no orthogonal routing: this file does not run
' the ortho stem rewrite, it guards that Smetana output is left unchanged.
skinparam linetype ortho
state Machine {
  state "full" as epFull <<entryPoint>>
  state "cachedToken" as epCached <<entryPoint>>
  state "authorised" as xpOk <<exitPoint>>
  state "refused" as xpNo <<exitPoint>>
  [*] --> Initialising
  epFull --> Initialising
  Initialising --> Awaiting : ready
  Initialising --> xpNo : fault
  epCached --> Validating
  Awaiting --> Validating : captured
  Awaiting --> xpNo : timeout
  Validating --> xpOk : accepted
  Validating --> xpNo : rejected
}
@enduml
