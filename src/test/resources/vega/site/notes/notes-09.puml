---
output: svg
---
@startuml
state a
state b
state c
state d

a -> b: //link label//
note top on link
  Link note
end note
b -down-> c: //link label//
note right on link
  Link note
end note
c -left-> d: //link label//
note bottom on link
  Link note
end note
d -up-> a: //link label//
note left on link
  Link note
end note
@enduml
