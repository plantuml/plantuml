---
output: svg
expected-description: (4 entities)
---
@startchen
left to right direction
skinparam backgroundColor white
notation compact

entity Account {
  Id : UUID <<KEY>>
  Profile {
    "Display name" as DisplayName
  }
  Roles <<MULTI>>
}

entity Session <<weak>> {
  Token <<discriminator>><<derived>>
}

relationship Opens <<identifying>> #lightblue;line:blue {
  At : TIMESTAMP
  Agent
}

Account -1- Opens
Opens =N= Session

@endchen
